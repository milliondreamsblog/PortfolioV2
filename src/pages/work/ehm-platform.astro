---
// EHM Platform — ClimAgro Analytics work. Engineer's-blog template.
// Built during the Apr 2025 – Jan 2026 ClimAgro role (per resume).
//
// TODO (Akshat, verify):
//   - The "EHM" acronym — what does it stand for? (Environment Health Management?)
//   - Stack: resume says "Spring Boot + REST + PostgreSQL + Docker" for ClimAgro,
//     but the supporting-work tags say "#nextjs #springboot #postgresql #typescript"
//     so I'm assuming a Next.js frontend over a Spring Boot backend.
//   - The "ML models powering climate-risk dashboards across 50+ regions" line —
//     elaborate if you'd like (which models, what risks, what regions).
//   - "View live" — your resume points this to LinkedIn; if there's a real
//     product URL, swap it in.
//
// Image slots: hero-banner.png, feature-dashboard.png, feature-ml-pipeline.png,
//              feature-api.png

import "../../styles/case-study-blog.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudySidebar from "../../components/casestudy/CaseStudySidebar.astro";
import Footer from "../../components/home/Footer.astro";
import CustomCursor from "../../components/home/CustomCursor.astro";
import Tag from "../../components/ui/Tag.astro";
import Button from "../../components/ui/Button.astro";
import { getCurrentVisitor } from "../../lib/visitor-server";

export const prerender = false;

const visitor = await getCurrentVisitor(Astro);
const cursorColor = visitor?.color ?? "orange";

const tocSections = [
  { id: "context", label: "Context" },
  { id: "problem", label: "The problem" },
  { id: "architecture", label: "Architecture" },
  { id: "implementation", label: "Implementation" },
  { id: "tradeoffs", label: "Tradeoffs" },
  { id: "reflection", label: "Reflection" },
];

const metrics = [
  { value: "50+", label: "Regions covered" },
  { value: "5+", label: "Enterprise workflows" },
  { value: "3+", label: "Departments served" },
];

const highlights = [
  {
    num: "01",
    title: "ML models, deployed and monitored end-to-end",
    body: "I integrated and deployed pre-trained climate-risk models to power dashboards across 50+ regions. Owning the deployment meant owning the boring parts too — versioning, monitoring, scaling under growing data volumes, and dealing with the inevitable model drift over time.",
    img: "/images/projects/ehm/feature-ml-pipeline.png",
  },
  {
    num: "02",
    title: "REST APIs that connected ML output to real workflows",
    body: "The models were the easy part. The hard part was turning their output into JSON that 5+ enterprise workflows across 3+ departments could consume — clean, versioned, well-typed APIs that hid the ML messiness behind a contract the consumers could rely on.",
    img: "/images/projects/ehm/feature-api.png",
  },
  {
    num: "03",
    title: "Logging and metrics for everything that touched inference",
    body: "ML inference fails in subtle ways — slowly, silently, statistically. I instrumented every stage with structured logs and metrics: ingestion latency, model latency, output distribution drift, request volume per department. The dashboards weren't a nice-to-have; they were how we knew the system was healthy.",
    img: "/images/projects/ehm/feature-dashboard.png",
  },
];

const tradeoffs = [
  {
    decision: "Spring Boot for the backend, Next.js for the dashboards",
    reason: "Spring Boot was the company standard for enterprise APIs — predictable, well-tested, easy for the rest of the team to extend. Next.js handled the dashboard side with the modern React ergonomics the climate-risk visualizations needed.",
    cost: "Two languages to maintain. Manageable because the boundary between them is a clean REST contract, not shared code.",
  },
  {
    decision: "Pre-trained models, deployed — not trained from scratch",
    reason: "Climate-risk models exist; what didn't exist was a way to integrate them into enterprise workflows reliably. My job wasn't to invent the model, it was to ship it. That focus let me solve the actual bottleneck (deployment + monitoring) instead of academic ML problems.",
    cost: "Limited control over model performance. When the model misbehaved, I could only tune around it — retraining wasn't on the table.",
  },
  {
    decision: "Logs and metrics from day one, not as an afterthought",
    reason: "ML systems decay quietly. By the time someone notices the predictions are wrong, you've been wrong for weeks. Instrumenting everything from day one — even when the system was small — meant we caught drift early instead of getting embarrassed in production.",
    cost: "More upfront work. Paid back the first time a quiet ingestion latency creep showed up in a metrics graph before it broke any dashboards.",
  },
];

const reflections = [
  {
    title: "Deploying ML is mostly not ML",
    body: "I expected to spend time on model tuning. I actually spent most of the time on Spring Boot endpoints, Postgres schemas, Docker images, and the boring plumbing that keeps inference running. That was the work — and it was worth doing well.",
  },
  {
    title: "The dashboard is the product, not the model",
    body: "Five departments used the dashboards. None of them cared about the model architecture. They cared whether the numbers matched their intuition and whether the page loaded. Treating the model as an implementation detail of a product, not the product itself, was the right framing.",
  },
  {
    title: "Working in production-grade enterprise code is its own discipline",
    body: "First time on a real enterprise codebase. Different rhythm — code reviews, performance tuning on EC2, observability hooks for systems other engineers depend on. The skills don't transfer from side projects automatically; you have to learn them on the job.",
  },
];
---

<BaseLayout
  title="EHM Platform — Akshat Darshi"
  description="Climate-risk ESG SaaS at ClimAgro Analytics (IIT Kanpur–funded). Integrated and deployed pre-trained ML models powering dashboards across 50+ regions. Spring Boot, Next.js, PostgreSQL, Docker."
>
  <div class="flex items-stretch min-h-screen" id="top">
    <CaseStudySidebar sections={tocSections} active="context" />

    <main class="flex-1 min-w-0 p-4 sm:p-6 md:p-10 flex flex-col gap-8 sm:gap-10">
      <div class="csb-root" data-theme="orange">
        <section class="csb-hero rounded-[24px] overflow-hidden h-[280px] mb-8">
          <img src="/images/projects/ehm/hero-banner.png" alt="EHM Platform — climate-risk dashboards" loading="eager" class="block w-full h-full object-cover object-center" />
        </section>

        <section class="flex flex-col gap-3 mb-8">
          <div class="flex items-center gap-2">
            <Tag>Work</Tag>
            <Tag>ESG SaaS</Tag>
          </div>
          <h1 class="font-[family-name:var(--font-display)] font-light text-[28px] sm:text-[34px] md:text-[40px] leading-[1.1] text-[var(--color-ink)]">
            EHM Platform &mdash; ML in production at ClimAgro
          </h1>
          <p class="font-[family-name:var(--font-body)] text-base text-[var(--color-ink-dim)] leading-relaxed">
            ESG SaaS work at <span class="csb-emph">ClimAgro Analytics</span> &mdash; an IIT
            Kanpur&ndash;funded climate-tech startup. I integrated and deployed pre-trained ML models
            powering climate-risk dashboards across <span class="csb-emph">50+ regions</span>,
            owning the end-to-end deployment, monitoring, and scaling.
          </p>
          <div class="flex items-center gap-3 flex-wrap mt-2">
            <Button href="https://www.linkedin.com/in/akshat-darshi/" variant="outline" target="_blank">View live <span aria-hidden="true">→</span></Button>
          </div>
        </section>

        <section class="grid grid-cols-3 gap-4 sm:gap-6 mb-8">
          {metrics.map((m) => (
            <div class="csb-metric"><p class="csb-metric-value">{m.value}</p><p class="csb-metric-label">{m.label}</p></div>
          ))}
        </section>

        <section class="csb-meta-grid grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-10 md:gap-[60px] p-4 rounded-[12px] mb-8" data-cursor-bg="orange">
          <div class="flex flex-col gap-2"><p class="font-[family-name:var(--font-mono)] text-base uppercase text-white">Role</p><p class="font-[family-name:var(--font-body)] text-base text-[var(--color-orange-2)] leading-snug">ML &amp; Full-Stack<br />Developer</p></div>
          <div class="flex flex-col gap-2"><p class="font-[family-name:var(--font-mono)] text-base uppercase text-white">Stack</p><p class="font-[family-name:var(--font-body)] text-base text-[var(--color-orange-2)] leading-snug">Spring Boot<br />Next.js &middot; TypeScript<br />PostgreSQL<br />Docker</p></div>
          <div class="flex flex-col gap-2"><p class="font-[family-name:var(--font-mono)] text-base uppercase text-white">Org</p><p class="font-[family-name:var(--font-body)] text-base text-[var(--color-orange-2)] leading-snug">ClimAgro Analytics<br />IIT Kanpur&ndash;funded<br />Climate-tech startup</p></div>
          <div class="flex flex-col gap-2"><p class="font-[family-name:var(--font-mono)] text-base uppercase text-white">Timeline</p><p class="font-[family-name:var(--font-body)] text-base text-[var(--color-orange-2)] leading-snug">Apr 2025 &ndash; Jan 2026</p></div>
        </section>

        <section id="context" data-cs-section class="csb-section flex flex-col gap-2 mb-10">
          <p class="csb-section-label">Context</p>
          <h2 class="csb-section-heading">A climate-tech startup with models that needed to ship.</h2>
          <p class="csb-section-body">
            ClimAgro Analytics is an IIT Kanpur&ndash;funded climate-tech startup building ESG-focused
            risk-analysis SaaS. The research team had pre-trained models for various climate risks
            &mdash; what they needed was someone to put those models in front of real users, in real
            workflows, across real regions. That was my role for the better part of a year.
          </p>
        </section>

        <section id="problem" data-cs-section class="csb-section flex flex-col gap-2 mb-10">
          <p class="csb-section-label">The problem</p>
          <h2 class="csb-section-heading">A model in a notebook is not a product.</h2>
          <p class="csb-section-body">
            Closing the gap between &ldquo;the model gives reasonable predictions in a Jupyter
            cell&rdquo; and &ldquo;an enterprise team uses these predictions in their workflow
            every day&rdquo; is its own discipline. A short list of what had to be true:
          </p>
          <ul class="csb-list">
            <li>Model inference had to scale across 50+ regions without melting</li>
            <li>Output had to flow into 5+ existing enterprise workflows via clean APIs</li>
            <li>The whole pipeline needed observability &mdash; you can&rsquo;t fix what you can&rsquo;t see</li>
            <li>Costs had to stay sane as data volume grew</li>
          </ul>
        </section>

        <section id="architecture" data-cs-section class="csb-section flex flex-col gap-2 mb-10">
          <p class="csb-section-label">Architecture</p>
          <h2 class="csb-section-heading">Spring Boot for APIs, Next.js for dashboards, Postgres for everything.</h2>

          <pre class="csb-arch-ascii" aria-label="System diagram">{`
   [Region data sources]
            │
            ▼
   ┌──────────────────────────────────┐
   │      Ingestion service           │
   └──────────┬───────────────────────┘
              ▼
   ┌──────────────────────────────────┐
   │   Pre-trained ML models          │
   │   (climate-risk inference)       │
   └──────────┬───────────────────────┘
              ▼
   ┌──────────────────────────────────┐
   │   PostgreSQL (results + metrics) │
   └──────────┬───────────────────────┘
              ▼
   ┌──────────────────────────────────┐
   │   Spring Boot REST API           │
   │   (versioned, typed contracts)   │
   └──────┬───────────────────┬───────┘
          ▼                   ▼
   [Next.js dashboards]   [Enterprise workflows
   (3+ departments)        across 5+ teams]

   Logs + metrics + traces flow alongside every stage.
`}</pre>
        </section>

        <section id="implementation" data-cs-section class="csb-section flex flex-col gap-2 mb-10">
          <p class="csb-section-label">Implementation</p>
          <h2 class="csb-section-heading">Three pieces that made the platform actually serve users.</h2>
          <div class="flex flex-col gap-8 mt-4">
            {highlights.map((h) => (
              <div class="csb-highlight">
                <div class="csb-highlight-img-wrap"><img src={h.img} alt={h.title} loading="lazy" class="csb-highlight-img" /></div>
                <div class="csb-highlight-details">
                  <div class="flex flex-col gap-1.5"><Tag>{h.num}</Tag><span class="font-[family-name:var(--font-display)] font-light text-[18px] text-[var(--color-ink)]">{h.title}</span></div>
                  <p class="font-[family-name:var(--font-body)] text-[14px] text-[var(--color-ink)] leading-snug">{h.body}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section id="tradeoffs" data-cs-section class="csb-section flex flex-col gap-2 mb-10">
          <p class="csb-section-label">Tradeoffs</p>
          <h2 class="csb-section-heading">Decisions that shaped the year.</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            {tradeoffs.map((t) => (
              <article class="csb-tradeoff">
                <h3 class="csb-tradeoff-title">{t.decision}</h3>
                <p class="csb-tradeoff-reason"><span class="csb-tradeoff-tag csb-tradeoff-tag--why">Why</span>{t.reason}</p>
                <p class="csb-tradeoff-cost"><span class="csb-tradeoff-tag csb-tradeoff-tag--cost">Cost</span>{t.cost}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="reflection" data-cs-section class="csb-section flex flex-col gap-2">
          <p class="csb-section-label">Reflection</p>
          <h2 class="csb-section-heading">What ClimAgro taught me.</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-2">
            {reflections.map((r) => (
              <article class="csb-reflection-tile bg-[var(--color-bg-light)] rounded-[16px] p-4 flex flex-col gap-2">
                <h3 class="font-[family-name:var(--font-body)] font-semibold text-[16px] text-[var(--color-ink)]">{r.title}</h3>
                <p class="font-[family-name:var(--font-body)] text-[14px] text-[var(--color-ink-dim)] leading-snug">{r.body}</p>
              </article>
            ))}
          </div>
        </section>
      </div>
    </main>
  </div>

  <Footer color={cursorColor} active="home" />
  <CustomCursor color={cursorColor} />
</BaseLayout>

<script>
  function initCsb() {
    const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    const sections = Array.from(document.querySelectorAll<HTMLElement>(".csb-section"));
    if (sections.length === 0) return;
    if (reduced || !("IntersectionObserver" in window)) { sections.forEach((s) => s.setAttribute("data-visible", "")); return; }
    const io = new IntersectionObserver((entries) => { for (const e of entries) { if (e.isIntersecting) { (e.target as HTMLElement).setAttribute("data-visible", ""); io.unobserve(e.target); } } }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
    sections.forEach((s) => io.observe(s));
  }
  initCsb();
  document.addEventListener("astro:page-load", initCsb);
</script>
