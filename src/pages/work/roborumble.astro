<script>
  /* Section-entry fade — same pattern as bawarchie/splunk */
  function initCaseStudyEntries() {
    const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    const sections = Array.from(document.querySelectorAll<HTMLElement>(".cs-section"));
    if (sections.length === 0) return;

    if (reduced) {
      sections.forEach((s) => s.setAttribute("data-visible", ""));
      return;
    }

    if (!("IntersectionObserver" in window)) {
      sections.forEach((s) => s.setAttribute("data-visible", ""));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).setAttribute("data-visible", "");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
    );
    sections.forEach((s) => io.observe(s));
  }
  initCaseStudyEntries();
  document.addEventListener("astro:page-load", initCaseStudyEntries);
</script>
